PORT=3000
# SQLite by default(no Docker needed) For Postgres:
# DATABASE_URL=postgresql+psycopg2://billing:billing@localhost:5432/billing
DATABASE_URL=sqlite:///./billing.db

# Razorpay TEST mode(optional). Leave empty to use seeded Free/Pro API keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=local_demo_secret
RAZORPAY_PRO_PLAN_ID=

# Integer money only (cents / microcents)never floats
PRICE_API_CALL_CENTS=1
PRICE_INPUT_TOKEN_MICROCENTS=300
PRICE_CACHED_INPUT_TOKEN_MICROCENTS=150
PRICE_OUTPUT_TOKEN_MICROCENTS=600
PRICE_REASONING_TOKEN_MICROCENTS=600
